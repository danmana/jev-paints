# Server-side only. Get one at https://typesafe.ai
TYPESAFE_AI_API_KEY=
# Optional model override (default jev-latest)
# JEV_MODEL=jev-latest
# HMAC key for signed painting sessions (any long random string). Falls back to the TypeSafe key in dev.
# PAINT_SIGNING_SECRET=
# Production storage. Without all three, paintings are saved to data/paintings/ on disk.
# BLOB_READ_WRITE_TOKEN=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
